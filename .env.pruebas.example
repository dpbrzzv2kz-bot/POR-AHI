# Entorno de PRUEBAS (proyecto de Supabase separado del real).
# Copia este archivo como `.env.local` y reemplaza los valores.
# `.env.local` tiene prioridad sobre `.env` (producción) y Git lo ignora.
# Para volver a producción, borra `.env.local` y reinicia Expo.
EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO-DE-PRUEBAS.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=TU_CLAVE_PUBLICABLE_DE_PRUEBAS
